---
import { site } from '../data/site.js';

const { about, links, name } = site;
---
<section class="about" id="about" aria-label={`About ${name}`}>
  {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  <p>
    {about.closing.before}<a href={links.linkedin} data-track="linkedin:about">{about.closing.linkText}</a>{about.closing.after}
  </p>
  <p class="sign"><strong>{name}</strong><span>{about.signRole}</span></p>
</section>
