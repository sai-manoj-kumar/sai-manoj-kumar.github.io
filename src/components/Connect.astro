---
import { site } from '../data/site.js';

const { connect, links } = site;
---
<section class="connect" id="connect" aria-labelledby="connect-h">
  <h2 id="connect-h">{connect.heading}</h2>
  <p>{connect.text}</p>
  <p class="links">
    <a class="btn" href={links.linkedin} data-track="linkedin:connect">{connect.linkedinLabel}</a>
    <a class="textlink" href={links.github} data-track="github:connect">{connect.githubLabel}</a>
  </p>
</section>
