---
import { site } from '../data/site.js';
import Icon from './Icon.astro';
import ThemeSwitch from './ThemeSwitch.astro';

const { name, links } = site;
---
<header class="topbar">
  <a class="topbar-name" href="#top">{name}</a>
  <a class="topbar-link" href={links.linkedin} data-track="linkedin:topbar"><Icon name="linkedin" /><span class="topbar-text">LinkedIn</span></a>
  <a class="topbar-link" href={links.github} data-track="github:topbar"><Icon name="github" /><span class="topbar-text">GitHub</span></a>
  <ThemeSwitch />
  <!-- Phones: the three-way switch becomes one button that steps System, Light, Dark. It drives the same radios. -->
  <button class="theme-cycle" type="button" data-mode="system" aria-label="Theme: System. Switch to Light">
    <svg class="mode-system" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" /></svg>
    <svg class="mode-light" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
    <svg class="mode-dark" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
  </button>
</header>
