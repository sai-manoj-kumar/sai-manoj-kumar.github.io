---
import { site } from '../data/site.js';
import Icon from './Icon.astro';
import ThemeSwitch from './ThemeSwitch.astro';

const { name, links } = site;
---
<header class="topbar">
  <a class="topbar-name" href="#top">{name}</a>
  <a class="topbar-link" href={links.linkedin} data-track="linkedin:topbar"><Icon name="linkedin" />LinkedIn</a>
  <a class="topbar-link" href={links.github} data-track="github:topbar"><Icon name="github" />GitHub</a>
  <ThemeSwitch />
</header>
