---
import { site } from '../data/site.js';
import Icon from './Icon.astro';

const { footer, links, name } = site;
// The home page passes `projects` for a small link to /projects; the projects page itself leaves it off.
const { projects = false } = Astro.props;
const profile = (url) => url.replace('https://www.', '').replace('https://', '');
---
<footer class="end">
  <p>
    © {footer.year} {name} ·
    <a href={links.linkedin}><Icon name="linkedin" />{profile(links.linkedin)}</a> ·
    <a href={links.github}><Icon name="github" />{profile(links.github)}</a>
  </p>
  {projects && <p class="end-more"><a href="/projects/">Side projects</a></p>}
</footer>
