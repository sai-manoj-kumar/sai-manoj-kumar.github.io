---
import { site } from '../data/site.js';
import Icon from './Icon.astro';

const { footer, links, name } = site;
const profile = (url) => url.replace('https://www.', '').replace('https://', '');
---
<footer class="end">
  <p>
    © {footer.year} {name} ·
    <a href={links.linkedin}><Icon name="linkedin" />{profile(links.linkedin)}</a> ·
    <a href={links.github}><Icon name="github" />{profile(links.github)}</a>
  </p>
</footer>
