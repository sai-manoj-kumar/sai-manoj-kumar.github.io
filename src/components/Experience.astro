---
import { site } from '../data/site.js';
import MemoryBars from './diagrams/MemoryBars.astro';
import HeaderRewrite from './diagrams/HeaderRewrite.astro';
import Traceroute from './diagrams/Traceroute.astro';

const diagrams = { memory: MemoryBars, rewrite: HeaderRewrite, trace: Traceroute };
---
<section class="work" id="work" aria-labelledby="work-h">
  <h2 id="work-h">Experience</h2>
  {site.experience.map((role) => {
    const Diagram = role.visual ? diagrams[role.visual] : null;
    return (
      <article class="role" data-role={role.slug}>
        <div class="role-head">
          <h3>{role.project}</h3>
          <p class="who">{role.company}, {role.title}</p>
          <p class="summary">{role.summary}</p>
        </div>
        <div class="role-body">
          <div class="role-inner">
            {role.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {Diagram && <Diagram />}
          </div>
        </div>
      </article>
    );
  })}
</section>
